{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@57eme-regiment/renenutet-api-contract": [
        "packages/contract/src/index.ts"
      ],
      "@57eme-regiment/renenutet-api-contract/*": ["packages/contract/src/*"]
    }
  },
  "files": ["src/shared/types/fastify.d.ts"],
  "include": ["src/**/*", "packages/contract/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
