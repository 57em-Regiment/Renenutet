{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@57eme-regiment/renenutet-api-contract": [
        "packages/contract/src/index.ts"
      ],
      "@57eme-regiment/renenutet-api-contract/*": ["packages/contract/src/*"],
      "@57eme-regiment/krang-api-contract": ["../Krang/API/packages/contract/src/index.ts"],
      "@57eme-regiment/krang-api-contract/*": ["../Krang/API/packages/contract/src/*"],
      "@57eme-regiment/auth-contracts": ["../wan-shi-tong/packages/auth-contracts/src/index.ts"],
      "@57eme-regiment/auth-contracts/*": ["../wan-shi-tong/packages/auth-contracts/src/*"],
      "@57eme-regiment/auth-server": ["../wan-shi-tong/packages/auth-server/src/index.ts"],
      "@57eme-regiment/nabu-errors": ["nabu/packages/errors/src/index.ts"],
      "@57eme-regiment/nabu-fastify": ["nabu/packages/fastify/src/index.ts"],
      "@57eme-regiment/nabu-logger": ["nabu/packages/logger/src/index.ts"]
    }
  },
  "files": ["src/shared/types/fastify.d.ts"],
  "include": ["src/**/*", "packages/contract/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
